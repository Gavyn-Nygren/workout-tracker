{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["formpose"],
  "ios": {
    "iosModuleName": "FormPose"
  },
  "android": {
    "androidNamespace": ["formpose"],
    "androidCxxLibName": "FormPose"
  },
  "autolinking": {
    "FormPose": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridFormPose"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
