{
  "expo": {
    "name": "Exercise Tracker",
    "slug": "exercise-tracker",
    "scheme": "exercisetracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gavynnygren.exercisetracker",
      "usesAppleSignIn": true,
      "deploymentTarget": "17.0",
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "package": "com.gavynnygren.exercisetracker",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID unlocks the app when the app lock is on. The app never sees your face."
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-dev-client",
        {
          "toolsButton": false,
          "showMenuAtLaunch": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F2F4F7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0D10"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#F2F4F7",
    "extra": {
      "eas": {
        "projectId": "b6da9cab-c7e9-420a-84cf-f016dfc25da8"
      }
    },
    "owner": "gavyn17"
  }
}
