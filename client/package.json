{
  "name": "exercise-tracker",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "node --import tsx --test --experimental-sqlite --no-warnings=ExperimentalWarning \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-community/datetimepicker": "9.2.1",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/react-query": "~5.103.3",
    "expo": "~58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-battery": "~58.0.3",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-vision-camera": "5.2.4",
    "react-native-vision-camera-worklets": "5.2.4",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "nitrogen": "0.37.2",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "react-native-reanimated",
          "react-native-worklets"
        ]
      }
    }
  }
}
